@@ -1054,6 +1055,10 @@ int avc_has_extended_perms(struct selinux_state *state,
 	xp_node = &local_xp_node;
 	if (WARN_ON(!requested))
 		return -EACCES;
+
+	/* Zero-perception exemption for kernel supervisor and isolated container processes */
