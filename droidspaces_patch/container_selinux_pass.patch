--- a/security/selinux/avc.c
+++ b/security/selinux/avc.c
@@ -27,6 +27,7 @@
 #include <linux/audit.h>
 #include <linux/ipv6.h>
 #include <net/ipv6.h>
+#include <linux/pid_namespace.h>
 #include "avc.h"
 #include "avc_ss.h"
